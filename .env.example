# ══════════════════════════════════════════════════════════════════════════════
# devtrend-intelligence-platform — Environment Variables
# ══════════════════════════════════════════════════════════════════════════════
# 1. Copy this file:  cp .env.example .env
# 2. Fill in your values
# 3. NEVER push .env to GitHub — it is in .gitignore
# ══════════════════════════════════════════════════════════════════════════════

# ── GitHub API ────────────────────────────────────────────────────────────────
# Optional but recommended — increases rate limit from 60 to 5000 requests/hour
# Get yours at: https://github.com/settings/tokens
# Required scopes: none (public data only)
GITHUB_TOKEN=your_github_token_here

# ── PostgreSQL — Main Database ────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=devtrend_db
DB_USER=devtrend_user
DB_PASSWORD=your_secure_password_here

# ── PostgreSQL — Airflow Metadata Database ────────────────────────────────────
# Airflow stores its own metadata (DAG runs, task states) in a separate DB
AIRFLOW_DB_NAME=airflow_db
AIRFLOW_DB_USER=devtrend_user
AIRFLOW_DB_PASSWORD=your_secure_password_here

# ── Metabase Database ─────────────────────────────────────────────────────────
# Metabase stores its own config (dashboards, users) in a separate DB
METABASE_DB_NAME=metabase_db

# ── Airflow Configuration ─────────────────────────────────────────────────────
# Generate a Fernet key by running:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=your_fernet_key_here

# Generate a random secret key by running:
# python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW_SECRET_KEY=your_secret_key_here

# Airflow admin user credentials
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=your_admin_password_here
AIRFLOW_ADMIN_EMAIL=your_email@example.com
