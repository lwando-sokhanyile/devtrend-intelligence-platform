FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Copy and install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy the full src folder (collectors + common utilities)
COPY src/ ./src/

# Default command — runs all three collectors in sequence
CMD ["sh", "-c", "python src/collectors/repos_collector.py && python src/collectors/languages_collector.py && python src/collectors/developers_collector.py"]
